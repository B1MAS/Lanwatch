[Unit]
Description=LANwatch local network monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/home/YOUR_LINUX_USER/lanwatch
EnvironmentFile=/home/YOUR_LINUX_USER/.config/lanwatch/credentials.env
ExecStart=/usr/bin/python3 -m lanwatch monitor --router http://192.168.31.1 --adapter miwifi --interval 60 --data-dir /home/YOUR_LINUX_USER/.lanwatch
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/YOUR_LINUX_USER/.lanwatch

[Install]
WantedBy=default.target
